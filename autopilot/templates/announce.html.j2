{%- import "_macros.j2" as m with context -%}
<!-- 主旨：【陽明交大創創社】第{{ n_zh }}堂社課預告｜{{ title }} -->
{{ m.wrap_open() }}
{{ m.p("創創社的夥伴們，大家好！") }}
<h2 style="margin:0 0 6px 0;font-family:{{ font }};font-size:21px;line-height:1.5;color:#222222;">{{ session_label }}｜{{ md_week }}</h2>
<h3 style="margin:0 0 20px 0;font-family:{{ font }};font-size:18px;line-height:1.5;color:#8a4f00;">{{ title_main }}{% if title_sub %}<br>{{ title_sub }}{% endif %}</h3>
{{ m.p("<strong>" ~ hook ~ "</strong>" ~ hook_lead ~ "完整的講者與社課介紹放在信件下方。") }}
{{ m.infocard(session_label ~ "資訊") }}
{{ m.h2(session_label ~ "報名", 30) }}
<p style="margin:0;font-family:{{ font }};color:#222222;">花 1 分鐘填個表，讓我們知道你會不會來，也可以先把想問講者的問題丟給我們：</p>
{{ m.gold(form_url, "填寫課前表單") }}
<p style="margin:0 0 6px 0;font-family:{{ font }};font-size:14px;color:#555555;">請於 <strong>{{ deadline_text }}</strong> 前完成填寫。</p>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:14px 0 0 0;"><tr><td style="border-radius:6px;">{{ m.goldline(calendar_url | replace("&", "&amp;"), "加到 Google 日曆") }}</td></tr></table>
{{ m.hr() }}
<h2 style="margin:0 0 12px 0;font-family:{{ font }};font-size:20px;line-height:1.5;color:#222222;">講者與社課介紹</h2>
{% for para in intro %}{{ m.p(para) }}
{% endfor %}{{ m.p("<strong>" ~ hook ~ "</strong>") }}
<p style="margin:24px 0 10px 0;font-family:{{ font }};font-size:17px;font-weight:bold;color:#222222;">社課內容</p>
{% for h in highlights %}{{ m.p("<strong>(" ~ loop.index ~ ") " ~ h.title ~ "</strong><br>" ~ h.body) }}
{% endfor %}{{ m.hr() }}
<p style="margin:0;font-family:{{ font }};color:#222222;">{{ md }} 晚上，{{ room }} 見！{{ closing }}</p>
{{ m.footer() }}
<!--
檢查清單
- [ ] 按鈕連到本期網址
- [ ] 日期、星期、時間、地點與預告內容一致
- [ ] 無費用、無報到時段、無個資
- [ ] 寄給自己用手機與深色模式各看一次
- [ ] 收件人只有社團信箱，社員名單在密件副本
-->
