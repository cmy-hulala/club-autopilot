{%- import "_macros.j2" as m with context -%}
<!-- 主旨：【{{ club.short }}】第{{ n_zh }}堂社課課後資訊｜{{ title }} -->
{{ m.wrap_open() }}
{{ m.p(club.short ~ "的夥伴們，大家好！") }}
{{ m.p("謝謝大家參加" ~ session_label ~ "「<strong>" ~ title ~ "</strong>」，也謝謝 " ~ speaker.name ~ " 的精彩分享！") }}
{% if slides_url %}{{ m.dark(slides_url, "查看社課簡報") }}{% endif %}
<h3 style="margin:30px 0 6px 0;font-family:{{ font }};font-size:18px;line-height:1.5;color:#8a4f00;">{{ session_label }}回饋表單</h3>
<p style="margin:0;font-family:{{ font }};font-size:15px;line-height:1.8;color:#222222;">歡迎大家花 1 分鐘提供意見，一起讓下一次活動更好！</p>
{{ m.gold(feedback_url, "填寫課後回饋表單") }}
{{ m.p("期待再次與創創夥伴們相聚！") }}
{{ m.footer() }}
